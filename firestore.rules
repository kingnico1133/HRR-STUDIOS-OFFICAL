rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validVote() {
      let data = request.resource.data;
      let reasons = data.reasons;
      return data.keys().hasAll(['vote', 'reasons'])
        && data.keys().hasOnly(['vote', 'reasons'])
        && data.vote is string
        && data.vote in ['like', 'dislike']
        && reasons is map
        && reasons.size() <= 3
        && reasons.keys().hasOnly([
          'graphics', 'weapons', 'void-forge', 'ship-skins',
          'endless-mode', 'sound-effects', 'difficulty', 'gameplay',
          'too-difficult', 'too-easy', 'bugs-glitches', 'controls',
          'content', 'performance'
        ]);
    }

    match /votes/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validVote();
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}